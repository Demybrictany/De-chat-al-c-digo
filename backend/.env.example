DB_SYNCHRONIZE=false

# Solo bootstrap del primer administrador. No hay clave predeterminada.
# Usa un correo valido y una clave propia de 8 caracteres minimo y 72 bytes maximo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Administrador

Project hospital_system {
  database_type: 'MySQL'
  Note: 'Modelo de datos para sistema de gestion hospitalaria: historial medico, recetas, citas, alertas de pacientes cronicos, pacientes fallecidos/prioritarios y banco de productos de farmacia. Sin ENUM: todo valor cerrado vive en tabla de catalogo. Toda escritura de negocio audita created_by_id/updated_by_id y audit_logs.'
}

// ─────────────────────────────────────────────
// Catalogos (sustituyen a los antiguos ENUM)
// Solo lectura desde la API; se siembran (seed) al desplegar.
// ─────────────────────────────────────────────

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  status int [not null, default: 1]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Catalogo de roles: admin, doctor, nurse, receptionist, pharmacist'
}

Table appointment_statuses {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Catalogo: scheduled, completed, cancelled, no_show'
}

Table alert_statuses {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Catalogo: active, resolved'
}

Table product_types {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Catalogo: medicamento, muestra_medica'
}

// ─────────────────────────────────────────────
// Usuarios
// ─────────────────────────────────────────────

Table users {
  id int [pk, increment]
  role_id int [not null]
  full_name varchar(150) [not null]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Usuarios del sistema: medicos, administradores, recepcion, farmacia'
}

// ─────────────────────────────────────────────
// Dominio clinico
// ─────────────────────────────────────────────

Table patients {
  id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  birth_date date [not null]
  gender varchar(20)
  national_id varchar(30) [unique]
  phone varchar(30)
  address varchar(255)
  is_priority boolean [not null, default: false]
  is_deceased boolean [not null, default: false]
  deceased_at datetime
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Pacientes. is_priority e is_deceased cubren directamente esos dos requerimientos'
}

Table medical_histories {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  visit_date datetime [not null]
  diagnosis text
  notes text
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Historial medico: cada fila es una consulta / evento clinico'
}

Table chronic_conditions {
  id int [pk, increment]
  patient_id int [not null]
  condition_name varchar(150) [not null]
  diagnosed_at date
  severity varchar(30)
  is_active boolean [not null, default: true]
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Condiciones cronicas por paciente; disparan alertas de seguimiento'
}

Table alerts {
  id int [pk, increment]
  patient_id int [not null]
  chronic_condition_id int
  status_id int [not null]
  alert_type varchar(50) [not null]
  message text [not null]
  triggered_at datetime [not null, default: `now()`]
  resolved_at datetime
  resolved_by_id int
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Alertas para pacientes cronicos (extensible a otros disparadores). status_id -> alert_statuses'
}

Table appointments {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  status_id int [not null]
  scheduled_at datetime [not null]
  reason varchar(255)
  notes text
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Registro de citas medicas. status_id -> appointment_statuses'
}

Table pharmacy_products {
  id int [pk, increment]
  type_id int [not null]
  name varchar(150) [not null]
  manufacturer varchar(150)
  stock_quantity int [not null, default: 0]
  unit varchar(30)
  expiration_date date
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Banco de datos de productos de farmacia y muestras medicas. type_id -> product_types'
}

Table prescriptions {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  medical_history_id int
  issued_at datetime [not null, default: `now()`]
  notes text
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Recetas medicas emitidas a un paciente'
}

Table prescription_items {
  id int [pk, increment]
  prescription_id int [not null]
  pharmacy_product_id int [not null]
  dosage varchar(100)
  frequency varchar(100)
  duration varchar(100)
  quantity int [not null, default: 1]
  created_by_id int [not null]
  updated_by_id int
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'Detalle de medicamentos/muestras incluidos en una receta'
}

// ─────────────────────────────────────────────
// Auditoria: bitacora inmutable (solo insert)
// ─────────────────────────────────────────────

Table audit_logs {
  id int [pk, increment]
  user_id int
  action varchar(20) [not null]
  entity_name varchar(100) [not null]
  entity_id int
  old_values json
  new_values json
  ip_address varchar(45)
  created_at datetime [not null, default: `now()`]

  Note: 'Bitacora inmutable. action: CREATE|UPDATE|DELETE|LOGIN|LOGIN_FAILED. Nunca se actualiza ni borra.'
}

// ─────────────────────────────────────────────
// Relaciones
// ─────────────────────────────────────────────

Ref: users.role_id > roles.id

Ref: patients.created_by_id > users.id
Ref: patients.updated_by_id > users.id

Ref: medical_histories.patient_id > patients.id
Ref: medical_histories.doctor_id > users.id
Ref: medical_histories.created_by_id > users.id
Ref: medical_histories.updated_by_id > users.id

Ref: chronic_conditions.patient_id > patients.id
Ref: chronic_conditions.created_by_id > users.id
Ref: chronic_conditions.updated_by_id > users.id

Ref: alerts.patient_id > patients.id
Ref: alerts.chronic_condition_id > chronic_conditions.id
Ref: alerts.status_id > alert_statuses.id
Ref: alerts.resolved_by_id > users.id
Ref: alerts.created_by_id > users.id
Ref: alerts.updated_by_id > users.id

Ref: appointments.patient_id > patients.id
Ref: appointments.doctor_id > users.id
Ref: appointments.status_id > appointment_statuses.id
Ref: appointments.created_by_id > users.id
Ref: appointments.updated_by_id > users.id

Ref: pharmacy_products.type_id > product_types.id
Ref: pharmacy_products.created_by_id > users.id
Ref: pharmacy_products.updated_by_id > users.id

Ref: prescriptions.patient_id > patients.id
Ref: prescriptions.doctor_id > users.id
Ref: prescriptions.medical_history_id > medical_histories.id
Ref: prescriptions.created_by_id > users.id
Ref: prescriptions.updated_by_id > users.id

Ref: prescription_items.prescription_id > prescriptions.id
Ref: prescription_items.pharmacy_product_id > pharmacy_products.id
Ref: prescription_items.created_by_id > users.id
Ref: prescription_items.updated_by_id > users.id

Ref: audit_logs.user_id > users.id

// Migracion inicial: fechas de auditoria alineadas con TypeORM (precision 6).
// Tablas MySQL: InnoDB, utf8mb4, utf8mb4_unicode_ci.
// Revision del modelo - fase 1 (2026-10-13). No se ha aplicado a una BD real.
// Decisiones de catalogos:
// - roles, appointment_statuses, alert_statuses y product_types siguen normalizados.
// - severity y gender siguen como texto libre: no existe vocabulario cerrado acordado.
// - alert_type sigue como codigo extensible de texto: chronic_follow_up es el unico
//   disparador automatico actual, pero la API permite otros codigos sin lista cerrada.
// - roles.status conserva el entero existente: no hay definicion de sus valores.
//   Pendiente acordar si es activacion binaria (boolean) o estado multivalor (catalogo).
// - Si se definen listas cerradas, normalizar con FK y actualizar conjuntamente
//   entidades, registro TypeOrmModule.forFeature, DTOs, servicios, API y seed.
//   No se agregan catalogos sin valores acordados ni entidades sin registrar.
// Politica referencial: RESTRICT en DELETE y UPDATE, incluso en FKs opcionales.
// No borrar usuarios, catalogos ni registros clinicos referenciados. La anulacion
// o desactivacion es una decision de negocio; audit_logs debe permanecer inmutable.
// MySQL indexa las FKs al crearlas; los indices declarados abajo cubren consultas
// existentes y no imponen unicidad de horarios, consultas o productos por receta.
// Pendientes de capas superiores (fuera del alcance de esta fase):
// - UsersService: poblar createdById/updatedById desde el actor. NULL solo para
//   bootstrap/importacion controlada; no aceptar autoria desde DTOs del cliente.
// - Validar doctor activo y rol doctor, y la misma pertenencia de paciente en
//   alerta/condicion cronica y receta/historial; las FKs simples no lo garantizan.
// - Evitar cambiar el paciente de una condicion/historial ya referenciado sin
//   una politica que preserve la coherencia de las alertas/recetas existentes.
// - Aplicar prioridad/fallecimiento en todas las escrituras de pacientes.
// - Validar queries y rechazar null en campos obligatorios de DTOs parciales.
// - Stock y cantidades usan INT UNSIGNED (0..4294967295). Quantity >= 1 sigue
//   validado por el DTO de receta; UNSIGNED por si solo permite cero. Reforzar
//   servicios y limites superiores en DTOs; un CHECK >= 1 en MySQL requiere
//   evaluar la version del servidor y una migracion autorizada. No se declara
//   @Check como garantia en TypeORM/MySQL ni se generan scripts en esta fase.
// - Inventario: ajustes atomicos/transacciones para evitar actualizaciones perdidas.
// - Auditoria: transaccion con escritura de negocio, old/new completos, IP,
//   detalle de recetas y politica de bootstrap; no silenciar fallos de registro.
// - Citas: definir transiciones, duracion/disponibilidad y solapamientos antes
//   de imponer restricciones de unicidad. Resolver DTO con estados hardcodeados.
// - Validar coherencia is_deceased/deceased_at/is_priority y
//   resolved_at/resolved_by_id/estado de alerta. No se inventan reglas nuevas.
// Compatibilidad al aplicar el modelo (requiere autorizacion posterior):
// - Revisar datos historicos: negativos, cantidades cero, referencias huerfanas.
// - No cambiar tipos ni crear FKs en una BD existente antes de esa revision.
// - El primer admin puede tener ambos autores NULL; el seed actual sigue intacto.
// - updated_at usa UpdateDateColumn y ON UPDATE CURRENT_TIMESTAMP(6) en MySQL.
//   created_at/updated_at usan datetime(6), igual que los metadatos TypeORM.

Project hospital_system {
  database_type: 'MySQL'
  Note: 'Modelo de datos para sistema de gestion hospitalaria: historial medico, recetas, citas, alertas de pacientes cronicos, pacientes fallecidos/prioritarios y banco de productos de farmacia. Sin ENUM: todo valor cerrado vive en tabla de catalogo. Toda escritura de negocio audita created_by_id/updated_by_id y audit_logs.'
}

// ─────────────────────────────────────────────
// Catalogos (sustituyen a los antiguos ENUM)
// Solo lectura desde la API; se siembran (seed) al desplegar.
// ─────────────────────────────────────────────

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  status int [not null, default: 1]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Catalogo de roles: admin, doctor, nurse, receptionist, pharmacist'
}

Table appointment_statuses {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Catalogo: scheduled, completed, cancelled, no_show'
}

Table alert_statuses {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Catalogo: active, resolved'
}

Table product_types {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Catalogo: medicamento, muestra_medica'
}

// ─────────────────────────────────────────────
// Usuarios
// ─────────────────────────────────────────────

Table users {
  id int [pk, increment]
  role_id int [not null]
  full_name varchar(150) [not null]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_by_id int
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Usuarios del sistema. Autoria nullable para bootstrap del primer administrador; las escrituras autenticadas deben poblar los IDs desde UsersService.'

  indexes {
    role_id [name: 'idx_users_role']
  }
}

// ─────────────────────────────────────────────
// Dominio clinico
// ─────────────────────────────────────────────

Table patients {
  id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  birth_date date [not null]
  gender varchar(20)
  national_id varchar(30) [unique]
  phone varchar(30)
  address varchar(255)
  is_priority boolean [not null, default: false]
  is_deceased boolean [not null, default: false]
  deceased_at datetime
  is_archived boolean [not null, default: false]
  archived_at datetime(6)
  archived_by_id int
  archive_reason varchar(500)
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  indexes {
    (is_archived, id) [name: 'idx_patients_archived_id']
  }

  Note: 'Pacientes. Archivado administrativo sin borrar relaciones. Al restaurar se limpian los campos de archivo; los eventos anteriores permanecen en audit_logs.'
}

Table medical_histories {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  visit_date datetime [not null]
  diagnosis text
  notes text
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Historial medico: cada fila es una consulta / evento clinico'

  indexes {
    (patient_id, visit_date) [name: 'idx_histories_patient_visit']
    (doctor_id, visit_date) [name: 'idx_histories_doctor_visit']
  }
}

Table chronic_conditions {
  id int [pk, increment]
  patient_id int [not null]
  condition_name varchar(150) [not null]
  diagnosed_at date
  severity varchar(30)
  is_active boolean [not null, default: true]
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Condiciones cronicas por paciente; disparan alertas de seguimiento'

  indexes {
    (patient_id, is_active) [name: 'idx_conditions_patient_active']
  }
}

Table alerts {
  id int [pk, increment]
  patient_id int [not null]
  chronic_condition_id int
  status_id int [not null]
  alert_type varchar(50) [not null]
  message text [not null]
  triggered_at datetime [not null, default: `now()`]
  resolved_at datetime
  resolved_by_id int
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Alertas para pacientes cronicos (extensible a otros disparadores). status_id -> alert_statuses'

  indexes {
    (patient_id, triggered_at) [name: 'idx_alerts_patient_triggered']
    (status_id, triggered_at) [name: 'idx_alerts_status_triggered']
    chronic_condition_id [name: 'idx_alerts_condition']
  }
}

Table appointments {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  status_id int [not null]
  scheduled_at datetime [not null]
  reason varchar(255)
  notes text
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Registro de citas medicas. status_id -> appointment_statuses'

  indexes {
    (patient_id, scheduled_at) [name: 'idx_appointments_patient_schedule']
    (doctor_id, scheduled_at) [name: 'idx_appointments_doctor_schedule']
  }
}

Table pharmacy_products {
  id int [pk, increment]
  type_id int [not null]
  name varchar(150) [not null]
  manufacturer varchar(150)
  stock_quantity "int unsigned" [not null, default: 0]
  unit varchar(30)
  expiration_date date
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Banco de datos de productos de farmacia y muestras medicas. type_id -> product_types'

  indexes {
    type_id [name: 'idx_products_type']
    expiration_date [name: 'idx_products_expiration']
  }
}

Table prescriptions {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  medical_history_id int
  issued_at datetime [not null, default: `now()`]
  notes text
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Recetas medicas emitidas a un paciente'

  indexes {
    (patient_id, issued_at) [name: 'idx_prescriptions_patient_issued']
    medical_history_id [name: 'idx_prescriptions_history']
  }
}

Table prescription_items {
  id int [pk, increment]
  prescription_id int [not null]
  pharmacy_product_id int [not null]
  dosage varchar(100)
  frequency varchar(100)
  duration varchar(100)
  quantity "int unsigned" [not null, default: 1]
  created_by_id int [not null]
  updated_by_id int
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'MySQL: ON UPDATE CURRENT_TIMESTAMP(6)']

  Note: 'Detalle de medicamentos/muestras incluidos en una receta'

  indexes {
    prescription_id [name: 'idx_items_prescription']
    pharmacy_product_id [name: 'idx_items_product']
  }
}

// ─────────────────────────────────────────────
// Auditoria: bitacora inmutable (solo insert)
// ─────────────────────────────────────────────

Table audit_logs {
  id int [pk, increment]
  user_id int
  action varchar(20) [not null]
  entity_name varchar(100) [not null]
  entity_id int
  old_values json
  new_values json
  ip_address varchar(45)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Note: 'Bitacora inmutable. action: CREATE|UPDATE|DELETE|LOGIN|LOGIN_FAILED. Nunca se actualiza ni borra.'

  indexes {
    (entity_name, entity_id, created_at) [name: 'idx_audit_entity_created']
    (user_id, created_at) [name: 'idx_audit_user_created']
  }
}

// ─────────────────────────────────────────────
// Relaciones
// ─────────────────────────────────────────────

Ref: users.role_id > roles.id [delete: restrict, update: restrict]
Ref: users.created_by_id > users.id [delete: restrict, update: restrict]
Ref: users.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: patients.created_by_id > users.id [delete: restrict, update: restrict]
Ref: patients.updated_by_id > users.id [delete: restrict, update: restrict]
Ref: patients.archived_by_id > users.id [delete: restrict, update: restrict]

Ref: medical_histories.patient_id > patients.id [delete: restrict, update: restrict]
Ref: medical_histories.doctor_id > users.id [delete: restrict, update: restrict]
Ref: medical_histories.created_by_id > users.id [delete: restrict, update: restrict]
Ref: medical_histories.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: chronic_conditions.patient_id > patients.id [delete: restrict, update: restrict]
Ref: chronic_conditions.created_by_id > users.id [delete: restrict, update: restrict]
Ref: chronic_conditions.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: alerts.patient_id > patients.id [delete: restrict, update: restrict]
Ref: alerts.chronic_condition_id > chronic_conditions.id [delete: restrict, update: restrict]
Ref: alerts.status_id > alert_statuses.id [delete: restrict, update: restrict]
Ref: alerts.resolved_by_id > users.id [delete: restrict, update: restrict]
Ref: alerts.created_by_id > users.id [delete: restrict, update: restrict]
Ref: alerts.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: appointments.patient_id > patients.id [delete: restrict, update: restrict]
Ref: appointments.doctor_id > users.id [delete: restrict, update: restrict]
Ref: appointments.status_id > appointment_statuses.id [delete: restrict, update: restrict]
Ref: appointments.created_by_id > users.id [delete: restrict, update: restrict]
Ref: appointments.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: pharmacy_products.type_id > product_types.id [delete: restrict, update: restrict]
Ref: pharmacy_products.created_by_id > users.id [delete: restrict, update: restrict]
Ref: pharmacy_products.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: prescriptions.patient_id > patients.id [delete: restrict, update: restrict]
Ref: prescriptions.doctor_id > users.id [delete: restrict, update: restrict]
Ref: prescriptions.medical_history_id > medical_histories.id [delete: restrict, update: restrict]
Ref: prescriptions.created_by_id > users.id [delete: restrict, update: restrict]
Ref: prescriptions.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: prescription_items.prescription_id > prescriptions.id [delete: restrict, update: restrict]
Ref: prescription_items.pharmacy_product_id > pharmacy_products.id [delete: restrict, update: restrict]
Ref: prescription_items.created_by_id > users.id [delete: restrict, update: restrict]
Ref: prescription_items.updated_by_id > users.id [delete: restrict, update: restrict]

Ref: audit_logs.user_id > users.id [delete: restrict, update: restrict]

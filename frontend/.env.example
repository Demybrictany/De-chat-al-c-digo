# URL base de la API del backend NestJS (incluye el prefijo /api).
# El backend escucha en el puerto 3001 por defecto (ver backend/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Requerido por next-auth v5 para firmar la sesión.
# Genéralo con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
